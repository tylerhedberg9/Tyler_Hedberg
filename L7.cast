[9101.647673, "o", "\u001b[?2004l\r"]
[9101.64895, "o", "CC = gcc"]
[9101.64968, "o", "\r\nCFLAGS = -Wall -Wextra -Iheaders\r\nTARGET = test_fibonacci\r\n\r\n.PHONY: all test clean\r\n\r\nall: $(TARGET)\r\n\r\n$(TARGET): test_fibonacci.c fibonacci.c headers/fibonacci.h headers/utest.h\r\n\t$(CC) $(CFLAGS) test_fibonacci.c fibonacci.c -o $(TARGET) -lm\r\n\r\ntest: $(TARGET)\r\n\t./$(TARGET)\r\n\r\nclean:\r\n\trm -f $(TARGET)\r\n\r\n"]
