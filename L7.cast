[4540.213129, "o", "\r\nPLAY [Install and configure Gitea and its runner] ***************************************************************************\r\n"]
[4540.215687, "o", "\r\nTASK [Gathering Facts] ******************************************************************************************************\r\n"]
[4540.72836, "o", "\u001b[1;35m[WARNING]: Host 'localhost' is using the discovered Python interpreter at '/usr/bin/python3.13', but future installation of another Python interpreter could cause a different interpreter to be discovered. See https://docs.ansible.com/ansible-core/2.19/reference_appendices/interpreter_discovery.html for more information.\u001b[0m"]
