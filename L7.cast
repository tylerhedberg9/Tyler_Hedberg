[9567.213052, "o", "\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark\r\u001b[37d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[37;16H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy"]
[9567.214683, "o", "\r\u001b[2d\u001b(B\u001b[0m\u001b[3m\u001b[36m# This is a basic workflow to help you get started with Actions\r\u001b[4d"]
[9567.214755, "o", "\u001b(B\u001b[0m\u001b[23m\u001b[92mname\u001b[39m: \u001b(B\u001b[mCI\r\u001b[6d\u001b(B\u001b[0m\u001b[3m\u001b[36m# Controls when the workflow will run\r\u001b[7d\u001b(B\u001b[0m\u001b[23m\u001b[92mon\u001b[39m:\u001b[8d\b\b\u001b(B\u001b[0m\u001b[3m\u001b[36m # Triggers the workflow on push or pull request events but only for the \"main\" branch\u001b[9;3H\u001b(B\u001b[0m\u001b[23m\u001b[92mpush\u001b[39m:\u001b[10;5H\u001b[92mbranches\u001b[39m: \u001b[33m[\u001b[39m\u001b(B\u001b[m \u001b[95m\"main\"\u001b[39m\u001b(B\u001b[m \u001b[33m]\u001b[11;3H\u001b[92mpull_request\u001b[39m:\u001b[12;5H\u001b[92mbranches\u001b[39m: \u001b[33m[\u001b[39m\u001b(B\u001b[m \u001b[95m\"main\"\u001b[39m\u001b(B\u001b[m \u001b[33m]\u001b[14;2H\u001b(B\u001b[0m\u001b[3m\u001b[36m # Allows you to run this workflow manually from the Actions tab\u001b[15;3H"]
[9567.214814, "o", "\u001b(B\u001b[0m\u001b[23m\u001b[92mworkflow_dispatch\u001b[39m:\r\u001b[17d\u001b(B\u001b[0m\u001b[3m\u001b[36m# A workflow run is made up of one or more jobs that can run sequentially or in parallel\r\u001b[18d\u001b(B\u001b[0m\u001b[23m\u001b[92mjobs\u001b[39m:\u001b[19;2H\u001b(B\u001b[0m\u001b[3m\u001b[36m # This workflow contains a single job called \"build\"\u001b[20;3H"]
[9567.214872, "o", "\u001b(B\u001b[0m\u001b[23m\u001b[92mbuild\u001b[39m:\u001b[21;4H\u001b(B\u001b[0m\u001b[3m\u001b[36m # The type of runner that the job will run on\u001b[22;5H\u001b(B\u001b[0m\u001b[23m\u001b[92mruns-on\u001b[39m: \u001b(B\u001b[mubuntu-latest\u001b[24;4H\u001b(B\u001b[0m\u001b[3m\u001b[36m # Steps represent a sequence of tasks that will be executed as part of the job\u001b[25;5H\u001b(B\u001b[0m\u001b[23m\u001b[92msteps\u001b[39m:\u001b[26;6H"]
[9567.214924, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mCheck out Lab4\u001b[27;9H\u001b[92muses\u001b[39m: \u001b(B\u001b[mactions/checkout@v4\u001b[29;6H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mDownload Lab3 branch\u001b[30;9H"]
[9567.21498, "o", "\u001b[92mrun\u001b[39m:\u001b(B\u001b[0;1m\u001b[38;5;38m |\u001b[31;11H\u001b[39m\u001b(B\u001b[mgit fetch origin Lab3\u001b[32;11Hgit checkout origin/Lab3 -- Lab3 .gitmodules\u001b[33;11Hgit submodule update --init --recursive -- Lab3/590MakefileLab\r\u001b[2d"]
