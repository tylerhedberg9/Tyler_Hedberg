[9088.052087, "o", "\r\n\u001b[?2004l\r"]
[9088.055608, "o", "# This is a basic workflow to help you get started with Actions"]
[9088.055884, "o", "\r\n"]
[9088.055952, "o", "\r\n"]
[9088.05601, "o", "name: CI"]
[9088.056065, "o", "\r\n\r\n# Controls when the workflow will run\r\non:"]
[9088.056292, "o", "\r\n  # Triggers the workflow on push or pull request events but only for the \"main\" branch\r\n  push:\r\n    branches: [ \"main\" ]\r\n  pull_request:\r\n    branches: [ \"main\" ]\r\n\r\n  # Allows you to run this workflow manually from the Actions tab\r\n  workflow_dispatch:\r\n\r\n# A workflow run is made up of one or more jobs that can run sequentially or in parallel\r\njobs:\r\n  # This workflow contains a single job called \"build\"\r\n  build:\r\n    # The type of runner that the job will run on\r\n    runs-on: ubuntu-latest\r\n\r\n    # Steps represent a sequence of tasks that will be executed as part of the job\r\n    steps:\r\n      - name: Check out Lab4\r\n        uses: actions/checkout@v4\r\n\r\n      - name: Download Lab3 branch\r\n        run: |\r\n          git fetch origin Lab3\r\n          git checkout origin/Lab3 -- Lab3 .gitmodules\r\n          git submodule update --init --recursive -- Lab3/590MakefileLab\r\n\r\n      - name: Build Lab3 using Makefile\r\n        run: |\r\n          cd Lab3\r\n          make\r\n\r\n      - name: Run Lab3 program\r\n        run: |\r\n          cd Lab3\r\n          ./fibonacci\r\n"]
[9088.056657, "o", "\u001b[?2004h"]
[9088.056759, "o", "\u001b]0;tylerhedberg@debian: ~/Tyler_Hedberg\u0007\u001b[01;32mtylerhedberg@debian\u001b[00m:\u001b[01;34m~/Tyler_Hedberg\u001b[00m$ "]
